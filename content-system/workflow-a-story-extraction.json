    {
      "parameters": {
        "jsCode": "const brand = $input.first().json;\nconst validated = $('Validate Input').first().json;\nconst icpContext = brand.icp_description ? 'Target audience: ' + brand.icp_description : '';\nconst voiceContext = brand.voice_rules ? 'Brand voice rules: ' + brand.voice_rules : '';\nconst lowContext = !brand.voice_rules || !brand.banned_patterns || !brand.gold_examples;\nconst systemPrompt = 'You are an expert content strategist. Extract distinct, usable stories from the interview transcript below.\\n\\n' + icpContext + '\\n' + voiceContext + '\\n\\n' + 'Return ONLY a valid JSON array of story objects. No markdown, no explanation, just the JSON array.\\n\\n' + 'Each story object must have exactly these fields:\\n' + '- title: string (concise, 5-10 words)\\n' + '- summary: string (2-4 sentences expanding on the story)\\n' + '- label: one of: insight | decision | failure_pattern | result | framework\\n' + '- source_quote: string (direct verbatim quote from the transcript supporting this story)\\n\\n' + 'Aim for 3-8 stories. Only include stories with clear narrative value.';\nreturn [{ json: { brand_id: brand.id, transcript_id: validated.transcript_id, request_id: validated.request_id, raw_text: validated.raw_text, low_context: lowContext, systemPrompt, attempt: 1 } }];"
      },
      "id": "wha-build-prompt",
      "name": "Build Extraction Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1264,
        64
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.raw_text }}",
        "options": {
          "systemMessage": "={{ $json.systemPrompt }}"
        }
      },
      "id": "wha-claude-extract",
      "name": "Claude Extract",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [
        1456,
        64
      ]
    },
    {
      "parameters": {
        "model": "anthropic/claude-sonnet-4.6",
        "options": {
          "maxTokens": 4096,
          "temperature": 0.3
        }
      },
      "id": "wha-claude-extract-model",
      "name": "Claude Extract Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenRouter",
      "typeVersion": 1,
      "position": [
        1456,
        256
      ],
      "credentials": {
        "openRouterApi": {
          "id": "REPLACE_ME",
          "name": "OpenRouter (native)"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const response = $input.first().json;\nconst prompt = $('Build Extraction Prompt').first().json;\nconst raw = response.output || (response.choices && response.choices[0] && response.choices[0].message && response.choices[0].message.content) || response.text || (response.content && response.content[0] && response.content[0].text) || '';\nlet stories = [], parseOk = false;\ntry {\n  const cleaned = raw.replace(/^```json\\s*/i,'').replace(/^```\\s*/i,'').replace(/```\\s*$/i,'').trim();\n  const parsed = JSON.parse(cleaned);\n  stories = Array.isArray(parsed) ? parsed : (parsed.stories || []);\n  const validLabels = ['insight','decision','failure_pattern','result','framework'];\n  stories = stories.filter(s => s.title && s.summary && validLabels.includes(s.label));\n  parseOk = stories.length > 0;\n} catch(e) {}\nreturn [{ json: { parseOk, stories, raw_llm_response: raw, brand_id: prompt.brand_id, transcript_id: prompt.transcript_id, request_id: prompt.request_id, low_context: prompt.low_context, attempt: prompt.attempt, systemPrompt: prompt.systemPrompt, raw_text: prompt.raw_text } }];"
      },
