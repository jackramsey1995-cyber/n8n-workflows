    {
      "parameters": {
        "jsCode": "const response = $input.first().json;\nconst prev = $('Parse Stories JSON').first().json;\nconst raw = response.output || (response.choices && response.choices[0] && response.choices[0].message && response.choices[0].message.content) || response.text || (response.content && response.content[0] && response.content[0].text) || '';\nlet stories = [], parseOk = false;\ntry {\n  const cleaned = raw.replace(/^```json\\s*/i,'').replace(/^```\\s*/i,'').replace(/```\\s*$/i,'').trim();\n  const parsed = JSON.parse(cleaned);\n  stories = Array.isArray(parsed) ? parsed : (parsed.stories || []);\n  const validLabels = ['insight','decision','failure_pattern','result','framework'];\n  stories = stories.filter(s => s.title && s.summary && validLabels.includes(s.label));\n  parseOk = stories.length > 0;\n} catch(e) {}\nreturn [{ json: { parseOk, stories, brand_id: prev.brand_id, transcript_id: prev.transcript_id, request_id: prev.request_id, low_context: prev.low_context } }];"
      },
