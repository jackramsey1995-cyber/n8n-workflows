      "parameters": {
        "jsCode": "const body = $input.first().json.body;\nconst required = ['request_id', 'transcript_id', 'brand_id', 'raw_text'];\nconst missing = required.filter(f => !body[f]);\nif (missing.length > 0) {\n  return [{ json: { valid: false, error: 'Missing fields: ' + missing.join(', '), request_id: body.request_id || null } }];\n}\nreturn [{ json: { valid: true, request_id: body.request_id, transcript_id: body.transcript_id, brand_id: body.brand_id, raw_text: body.raw_text } }];"
      },
