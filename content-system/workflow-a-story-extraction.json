    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\nfunction similarity(a, b) {\n  const s1 = a.toLowerCase().split(' '), s2 = b.toLowerCase().split(' ');\n  const set2 = new Set(s2);\n  const intersection = s1.filter(w => set2.has(w)).length;\n  const union = new Set([...s1, ...s2]).size;\n  return union === 0 ? 0 : intersection / union;\n}\nconst unique = [];\nfor (const story of data.stories) {\n  if (!unique.some(u => similarity(u.title, story.title) > 0.9)) unique.push(story);\n}\nreturn [{ json: { stories: unique, story_count: unique.length, brand_id: data.brand_id, transcript_id: data.transcript_id, request_id: data.request_id, low_context: data.low_context } }];"
      },
